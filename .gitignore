node_modules
dist
.DS_Store
.env
.env.*
!.env.example
*.local

.idea
.vscode/*
!.vscode/extensions.json

# 스토어에 올릴 빌드 산출물 보관소 — AAB 는 수십 MB 라 커밋하지 않는다.
# 워크트리에서 빌드하면 워크트리와 함께 사라지므로, 업로드할 파일은 여기 둔다.
store/build/

# Capacitor 네이티브 — 서명 비밀키·로컬 설정은 커밋 금지 (android/ ios/ 소스는 커밋)
*.keystore
*.jks
keystore.properties
key.properties
ios/App/Pods/
ios/App/App/public/
android/app/src/main/assets/public/

# 배포에 쓰지 않는 원본/중간 이미지 — 서빙되는 파생본(*_web.png, 배경 *.jpg)만 커밋한다.
# 소스 마스터는 git 히스토리에 남아 있고, 장기적으로 assets-src/ 분리(로드맵 C9) 예정.
public/assets/images/raw/
**/*_master_v*.png
**/*_transparent.png
public/assets/images/backgrounds/*.png
public/assets/images/stages/
public/assets/images/story/*.png
public/assets/images/ui/*_concept.png

# 녹음 다듬기(trim:voice)가 남기는 원본 백업
*.bak

# 세션 작업 폴더·이미지 원본(생성물)
.claude/
public/assets/images/characters/generated/

# 녹음 다듬기 전 원본 백업 (public/ 밖에 둬야 배포에 안 실린다)
.voice-backup/

# Play Developer API 서비스 계정 키 (절대 커밋 금지)
android/play-service-account.json

# App Store Connect API 키·서명 자산 (절대 커밋 금지)
# .p8 은 App Store Connect 에서 한 번만 받을 수 있다 — 잃어버리면 키를 새로 만들어야 한다.
ios/private_keys/
*.p8
*.p12
*.cer
*.mobileprovision

# fastlane 이 실행 때마다 남기는 리포트
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# iOS 로컬 빌드 산출물 (시뮬레이터 스모크 테스트의 DerivedData 포함)
ios/App/build/

# 영상 제작 작업 폴더 — 앱 빌드와 무관한 개인 작업물이라 저장소에 두지 않는다.
video/

# App Store 스크린샷 (iPhone 6.9" 37MB · iPad 13" 48MB)
# `npm run shots:store` 로 언제든 재생성되는 산출물이라 커밋하지 않는다.
# PNG 는 델타 압축이 안 돼서, UI 가 바뀌어 다시 찍을 때마다 히스토리에 85MB 가
# 통째로 새로 쌓인다 — 릴리스마다 반복되면 저장소가 감당하지 못한다.
# (store/screenshots/ 의 Play 용 8장은 이미 커밋돼 있어 그대로 둔다. 지워도 히스토리는
#  줄지 않으므로 실익이 없다. 앞으로 이쪽도 빼고 싶으면 git rm --cached 가 필요하다.)
store/screenshots-ios-6.9/
store/screenshots-ipad-13/
