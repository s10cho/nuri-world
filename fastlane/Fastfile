# iOS 배포 레인. 안드로이드는 `fastlane supply` 를 직접 호출하므로 여기 두지 않는다
# (DEPLOY.md 3장 참고).
#
# 인증은 App Store Connect API 키를 쓴다 — 2단계 인증 때문에 Apple ID 비밀번호
# 방식은 CI 에서 계속 막힌다. 키는 App Store Connect ▸ 사용자 및 액세스 ▸ 통합
# 에서 만들고, 내려받은 .p8 은 저장소 밖(ios/private_keys/)에 둔다.
#
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH
#   FASTLANE_TEAM_ID  (Apple Developer 팀 ID)

require "shellwords"
require "securerandom"

# xcode-select 가 CommandLineTools 를 가리키면 xcodebuild 를 못 찾아 build_app 이
# "Unable to locate Xcode" 로 죽는다(이 맥이 그 상태다). 영구 수정은
# `sudo xcode-select -s /Applications/Xcode.app` 이지만 관리자 권한이 필요하므로
# 여기서 채워 준다. 이미 설정돼 있으면 건드리지 않는다.
if File.directory?("/Applications/Xcode.app")
  ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer"
end

default_platform(:ios)

APP_ID = "com.sycho.nuri.hangulkingdom"
IPA = "store/build/nuri.ipa"
CERTS_DIR = "store/build/certs"
KEYCHAIN = "nuri-ios-build.keychain"

# API 키가 있으면 쓰고, 없으면 nil 을 돌려 준다(대화형 로그인으로 넘어감).
def asc_key
  return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_PATH"]
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

platform :ios do
  desc "계정·앱 등록·API 키가 실제로 통하는지 확인 (빌드 없음, 몇 초)"
  lane :verify do
    key = asc_key
    UI.user_error!("ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH 가 없습니다") unless key
    # 앱이 App Store Connect 에 등록돼 있지 않으면 여기서 바로 실패한다 —
    # 몇 분짜리 아카이브를 돌린 뒤에 알게 되는 것보다 낫다.
    n = latest_testflight_build_number(
      api_key: key, app_identifier: APP_ID, initial_build_number: 0
    )
    UI.success("App Store Connect 연결 OK — TestFlight 최신 빌드 번호: #{n}")
  end

  desc "웹 자산 동기화 + 버전 반영 (빌드 전 항상 실행)"
  lane :prepare do
    sh("cd .. && npm run build:native")
    sh("cd .. && node tools/apply-ios-version.mjs")
    sh("cd .. && npx cap sync ios")
  end

  desc "서명된 .ipa 를 만든다"
  lane :build do
    prepare
    key = asc_key
    UI.user_error!("ASC API 키 환경변수가 필요하다") unless key

    # --- 왜 이렇게까지 하는가 ------------------------------------------------
    # 1) 자동 서명으로는 이 계정에서 아카이브가 안 된다. 자동 서명은 아카이브를
    #    '개발용'으로 서명하려 드는데, 개발용 프로파일은 팀에 등록된 기기가 최소
    #    하나 있어야 Apple 이 발급한다. 새 계정에는 기기가 없다.
    #    CODE_SIGN_IDENTITY 를 배포용으로 덮으면 "conflicting provisioning settings"
    #    로 거부한다 — 자동 서명에서는 서명 ID 를 수동 지정할 수 없기 때문이다.
    #    → App Store 배포용 프로파일은 기기가 필요 없다. 그래서 수동 서명으로 간다.
    #
    # 2) 인증서 개인키를 로그인 키체인에 두면 codesign 이 접근할 때 macOS 가 GUI
    #    승인 팝업을 띄우고, 자동 빌드는 거기서 영영 멈춘다(실측 확인함).
    #    팝업을 없애려면 키체인 비밀번호로 partition list 를 설정해야 하는데,
    #    로그인 키체인이면 사용자의 비밀번호가 필요하다. 전용 키체인을 만들면
    #    우리가 정한 비밀번호로 그 설정을 할 수 있어 사용자 비밀번호가 필요 없다.
    # ------------------------------------------------------------------------
    keychain_pass = SecureRandom.hex(16)
    create_keychain(
      name: KEYCHAIN, password: keychain_pass,
      default_keychain: false, unlock: true, timeout: 3600,
      lock_when_sleeps: false, add_to_search_list: true
    )

    begin
      get_certificates(
        api_key: key, development: false, output_path: CERTS_DIR,
        keychain_path: File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db"),
        keychain_password: keychain_pass
      )
      # app_store 는 옵션이 아니다 — adhoc/development/developer_id 중 아무것도
      # 주지 않으면 App Store 프로파일이 기본값이다.
      result = get_provisioning_profile(api_key: key, app_identifier: APP_ID, output_path: CERTS_DIR)
      # sigh 는 프로파일 이름을 lane_context 가 아니라 환경변수로 넘긴다.
      profile = ENV["sigh_#{APP_ID}_appstore_profile-name"] || result
      UI.user_error!("프로비저닝 프로파일 이름을 알 수 없다") if profile.to_s.empty?
      UI.success("프로비저닝 프로파일: #{profile}")

      build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        output_directory: "store/build",
        output_name: "nuri.ipa",
        clean: true,
        export_method: "app-store",
        xcargs: [
          "DEVELOPMENT_TEAM=#{ENV.fetch('FASTLANE_TEAM_ID')}",
          "CODE_SIGN_STYLE=Manual",
          'CODE_SIGN_IDENTITY="Apple Distribution"',
          "PROVISIONING_PROFILE_SPECIFIER=#{profile.shellescape}"
        ].join(" "),
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { APP_ID => profile }
        }
      )
    ensure
      # 빌드가 실패해도 키체인은 치운다 — 남겨 두면 검색 목록만 지저분해진다.
      delete_keychain(name: KEYCHAIN)
    end
  end

  desc "TestFlight 에 올린다 (내부 테스터는 심사 없이 바로 설치)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_key,
      app_identifier: APP_ID,
      ipa: IPA,
      # changelog("테스트 정보")는 빌드 처리가 끝나야 붙일 수 있어서 기다린다.
      # fastlane 은 skip_waiting_for_build_processing 과 changelog 를 같이 못 쓴다.
      # 처리에 보통 5~15분 걸린다.
      skip_waiting_for_build_processing: false,
      # 내부 테스터(최대 100명)는 베타 심사 없이 바로 받는다. 외부 배포는 심사가 따로 필요하다.
      distribute_external: false,
      changelog: File.read("../store/release-notes.txt")
    )
  end

  desc "App Store Connect 에 실제로 등록된 스크린샷을 기기별로 확인한다"
  lane :shots_status do
    report_screenshots(strict: false)
  end

  desc "App Store 스크린샷만 올린다 (텍스트 메타데이터는 건드리지 않음)"
  lane :screenshots do
    # fastlane/screenshots/<로케일>/ 이 기본 위치라 경로를 따로 주지 않는다.
    # deliver 는 파일명이 아니라 **해상도**로 기기를 판별한다:
    #   2868×1320 → iPhone 6.9",  2752×2064 → iPad 13"
    # skip_metadata: true 면 UploadMetadata#upload 가 즉시 반환하므로 스토어 문안·설명은
    # 그대로 두고 스크린샷만 올라간다.
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      force: true,                      # HTML 미리보기 확인 프롬프트 생략(비대화식)
      run_precheck_before_submit: false
    )

    # deliver 는 업로드 뒤 등록을 확인하고, 확인이 안 되면 다시 올린다. 그런데 App Store
    # Connect 반영이 늦으면 이미 올라간 것을 "실패"로 보고 또 올려 **중복**이 생긴다.
    # 실제로 첫 업로드 때 3장이 이렇게 중복됐고, 나중에야 발견했다. 바로 잡아낸다.
    report_screenshots(strict: true)
  end

  desc "App Store 심사에 제출 (수동 출시)"
  lane :release do
    build
    upload_to_app_store(
      api_key: asc_key,
      app_identifier: APP_ID,
      ipa: IPA,
      submit_for_review: true,
      automatic_release: false,        # 승인돼도 자동 출시하지 않는다 — 출시 시점은 직접 고른다
      force: true,                     # HTML 미리보기 확인 절차 생략
      precheck_include_in_app_purchases: false,
      skip_screenshots: true,          # 스크린샷은 App Store Connect 에서 직접 올린다
      submission_information: {
        # 광고 식별자·제3자 분석 없음. 안드로이드 데이터 보안 선언과 같은 내용이다.
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end

# 등록된 스크린샷을 기기별로 세고 파일명을 찍는다. strict 면 중복이 있을 때 실패시킨다.
def report_screenshots(strict:)
  asc_key # Spaceship 토큰을 세운다
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("앱을 찾지 못했다: #{APP_ID}") unless app

  platform = Spaceship::ConnectAPI::Platform::IOS
  version = app.get_edit_app_store_version(platform: platform)
  state = "편집 중"
  if version.nil?
    version = app.get_live_app_store_version(platform: platform)
    state = "게시본"
  end
  UI.user_error!("App Store 버전이 없다") unless version
  UI.important("버전 #{version.version_string} (#{state}) — #{version.app_store_state}")

  total = 0
  dups = []
  version.get_app_store_version_localizations.each do |loc|
    loc.get_app_screenshot_sets.each do |set|
      names = set.app_screenshots.map(&:file_name)
      total += names.size
      UI.message("  #{loc.locale}  #{set.screenshot_display_type}: #{names.size}장")
      names.each_with_index { |nm, i| UI.message("      #{i + 1}. #{nm}") }
      dup = names.tally.select { |_, c| c > 1 }
      next if dup.empty?
      dups << "#{loc.locale}/#{set.screenshot_display_type}: #{dup.map { |k, v| "#{k} ×#{v}" }.join(', ')}"
      UI.error("      ↑ 중복: #{dup.map { |k, v| "#{k} ×#{v}" }.join(', ')}")
    end
  end

  if dups.empty?
    UI.success("합계 #{total}장 — 중복 없음")
  elsif strict
    UI.user_error!("스크린샷이 중복 등록됐다:\n  #{dups.join("\n  ")}\n" \
                   "`fastlane ios screenshots` 를 다시 돌리면 전부 지우고 새로 올린다.")
  else
    UI.error("합계 #{total}장 — 중복 #{dups.size}건")
  end
end
