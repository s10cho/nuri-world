{
  "name": "nuri-hangul-kingdom",
  "version": "1.0.0",
  "description": "누리의 한글 왕국 — 미취학 아동을 위한 한글 학습 모험 웹앱",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:native": "CAP=1 vite build",
    "sync": "npm run build:native && cap sync",
    "sync:ios": "npm run build:native && cap sync ios",
    "sync:android": "npm run build:native && cap sync android",
    "build:apk": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "build:aab": "npm run sync:android && cd android && ./gradlew bundleRelease",
    "preview": "vite preview",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"js/**/*.js\"",
    "generate:voice": "node tools/generate-voice-assets.mjs",
    "import:voice": "node tools/import-recorded-voice-assets.mjs",
    "convert:voice": "node tools/convert-recorded-voice.mjs",
    "record:voice": "vite --open /nuri-world/voice-scripts.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1"
  }
}
