{
  "name": "nuri-hangul-kingdom",
  "version": "1.0.0",
  "description": "누리의 한글 왕국 — 미취학 아동을 위한 한글 학습 모험 웹앱",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8000",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"js/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
