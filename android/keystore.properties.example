# 릴리스 서명 설정 템플릿 — 실제 값을 채워 android/keystore.properties 로 복사(gitignore됨).
# 키스토어 생성(비밀번호는 본인이 정하고 안전하게 보관 — 분실 시 앱 업데이트 영구 불가):
#   cd android
#   keytool -genkey -v -keystore release.keystore -alias nuri -keyalg RSA -keysize 2048 -validity 10000
# 그다음 이 파일을 keystore.properties 로 복사하고 아래 값을 채운다.

storeFile=release.keystore
storePassword=여기에_키스토어_비밀번호
keyAlias=nuri
keyPassword=여기에_키_비밀번호
